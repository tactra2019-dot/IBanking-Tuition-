datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum TuitionStatus {
  UNPAID
  PAID
}

enum PaymentStatus {
  PROCESSING
  REFUND_PENDING
  PENDING
  COMPLETED
  FAILED
  EXPIRED
}

model Student {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentCode String       @unique @map("student_code") @db.VarChar(20)
  fullName    String       @map("full_name") @db.VarChar(100)
  email       String       @db.VarChar(100)
  phone       String       @db.VarChar(20)
  faculty     String       @db.VarChar(100)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  tuitionFees TuitionFee[]
  payments    Payment[]

  @@map("students")
}

model TuitionFee {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  studentId String        @map("student_id") @db.Uuid
  semester  String        @db.VarChar(50)
  amount    Decimal       @db.Decimal(12, 2)
  status    TuitionStatus @default(UNPAID)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  student  Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@unique([studentId, semester])
  @@index([studentId, status])
  @@map("tuition_fees")
}

model Payment {
  id                   String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId            String        @map("account_id") @db.VarChar(50)
  studentId            String        @map("student_id") @db.Uuid
  tuitionFeeId         String        @map("tuition_fee_id") @db.Uuid
  amount               Decimal       @db.Decimal(12, 2)
  status               PaymentStatus @default(PENDING)
  transactionReference String        @unique @map("transaction_reference") @db.VarChar(50)
  payerEmail           String        @map("payer_email") @db.VarChar(100)
  receiptSent          Boolean       @default(false) @map("receipt_sent")
  failureReason        String?       @map("failure_reason") @db.Text
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  student    Student    @relation(fields: [studentId], references: [id], onDelete: Restrict)
  tuitionFee TuitionFee @relation(fields: [tuitionFeeId], references: [id], onDelete: Restrict)
  otpCodes   OtpCode[]

  @@index([accountId])
  @@index([tuitionFeeId, status])
  @@map("payments")
}

model OtpCode {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  paymentId String   @map("payment_id") @db.Uuid
  code      String   @db.VarChar(10)
  expiresAt DateTime @map("expires_at")
  isUsed    Boolean  @default(false) @map("is_used")
  attempts  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([code, isUsed, expiresAt])
  @@index([paymentId, isUsed])
  @@map("otp_codes")
}

model User {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username     String   @unique @db.VarChar(80)
  passwordHash String   @map("password_hash")
  fullName     String   @map("full_name") @db.VarChar(100)
  email        String   @db.VarChar(100)
  phone        String   @db.VarChar(20)
  account      Account?

  @@map("users")
}

model Account {
  id      String         @id @db.VarChar(50)
  userId  String         @unique @map("user_id") @db.Uuid
  balance BigInt
  user    User           @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  debits  AccountDebit[]

  @@map("accounts")
}

model AccountDebit {
  paymentId        String  @id @map("payment_id") @db.Uuid
  accountId        String  @map("account_id") @db.VarChar(50)
  amount           BigInt
  remainingBalance BigInt? @map("remaining_balance")
  refundedBalance  BigInt? @map("refunded_balance")
  account          Account @relation(fields: [accountId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("account_debits")
}


