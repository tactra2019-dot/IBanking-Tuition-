# Generate a random value of at least 32 characters and share ONLY with Payment Service.
NOTIFICATION_INTERNAL_KEY=
SERVER_ADDRESS=127.0.0.1
PORT=8085
# Local Mailpit; no real email is sent outside the machine.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
MAIL_FROM=no-reply@ibanking.local
# Real SMTP: set provider host/port/credentials; SMTP_AUTH=true, SMTP_STARTTLS=true.
# Spring Boot reads process environment; it does not load this file automatically.
