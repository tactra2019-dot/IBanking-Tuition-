{
  "name": "ibanking-tuition-services",
  "version": "1.0.0",
  "description": "TDTU iBanking Student & Payment Microservices with PostgreSQL Concurrency Control",
  "private": true,
  "scripts": {
    "dev": "tsx src/run-all.ts",
    "dev:student": "tsx watch src/student-service/index.ts",
    "dev:payment": "tsx watch src/payment-service/index.ts",
    "dev:account-mock": "tsx watch src/mock-account-service/index.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "seed": "tsx prisma/seed.ts",
    "test": "tsx tests/test-student-service.ts && tsx tests/test-payment-service.ts && tsx tests/test-swagger.ts && tsx tests/concurrency/run-all.ts",
    "test:concurrency": "tsx tests/concurrency/run-all.ts",
    "dev:core": "tsx src/api-gateway/index.ts",
    "dev:auth": "tsx src/auth-service/index.ts",
    "dev:account": "tsx src/account-service/index.ts",
    "db:account": "prisma db execute --schema prisma/schema.prisma --file sql/account-schema.sql",
    "seed:account": "tsx prisma/seed-account.ts",
    "test:core": "tsx --test tests/core.test.ts",
    "build": "tsc && node -e \"const fs = require('node:fs'); fs.cpSync('specs', 'dist/specs', { recursive: true }); fs.cpSync('docs', 'dist/docs', { recursive: true })\"",
    "test:e2e": "tsx --test tests/e2e.test.ts",
    "recover": "tsx src/payment-service/recover-once.ts",
    "seed:integration": "tsx prisma/seed-integration.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "nodemailer": "^6.10.0",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.4",
    "@types/nodemailer": "^6.4.17",
    "@types/swagger-ui-express": "^4.1.7",
    "prisma": "^6.4.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
